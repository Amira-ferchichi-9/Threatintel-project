# ─── Azure Active Directory ───────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-client-id>
AZURE_CLIENT_SECRET=<your-client-secret>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# ─── Azure Resource Group ─────────────────────────────────────────────────────
RESOURCE_GROUP=PFA_Email_Sandbox_RG
LOCATION=francecentral

# ─── Azure Blob Storage (attachment sandbox) ──────────────────────────────────
STORAGE_ACCOUNT_NAME=<your-storage-account-name>
STORAGE_ACCOUNT_KEY=<your-storage-account-key>
SANDBOX_CONTAINER_NAME=sandbox-files

# ─── Azure Cosmos DB ──────────────────────────────────────────────────────────
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_KEY=<your-cosmos-primary-key>
COSMOS_DATABASE=pfa_email_threats
COSMOS_CONTAINER=analyses

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── SMTP (Gmail App Password — not your account password) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail-address>@gmail.com
SMTP_PASS=<your-16-char-app-password>

# ─── Backend API ──────────────────────────────────────────────────────────────
# Used by the Logic App to reach the FastAPI /analyze endpoint.
# For local dev: http://localhost:8765
# For production: https://<your-public-domain-or-ngrok>
BACKEND_API_URL=http://localhost:8765

# ─── FastAPI server port ──────────────────────────────────────────────────────
API_PORT=8765
